# Cabeceras para Cloudflare Pages (también las lee Netlify).
# Los archivos de /assets/ llevan hash en el nombre (se pueden cachear para siempre); fotos y videos
# conservan su nombre al reemplazarse, así que se cachean un día.

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/img/*
  Cache-Control: public, max-age=86400

/video/*
  Cache-Control: public, max-age=86400

/fonts/*
  Cache-Control: public, max-age=86400

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
